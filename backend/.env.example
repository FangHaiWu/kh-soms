# ==========================================================
# KH-SOMS backend — mẫu biến môi trường
# Copy sang .env (đã gitignore) và điền giá trị thật.
# Tên biến ở đây PHẢI khớp key mà code đọc qua ConfigService/process.env.
# ==========================================================

# App
NODE_ENV=development
PORT=3000

# PostgreSQL (app.module.ts đọc đúng 5 key dưới đây)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Redis — backend của BullMQ (hàng đợi crawl/NLP)
REDIS_HOST=localhost
REDIS_PORT=6379

# Microservice Python (docker/local); để trống = dùng mặc định trong code
NLP_ANALYZER_URL=http://localhost:8001
EXTRACTOR_URL=http://localhost:8000

# CNC Lớp 2 — số bài cùng category trong cửa sổ 30 ngày để đánh dấu actor tái phạm
ACTOR_REPEAT_THRESHOLD=3

# ---------- Facebook collector ----------
# Khóa AES-256 mã hóa credential tài khoản công cụ trong DB.
# BẮT BUỘC, phải đúng 32 byte sau khi decode base64:
#   openssl rand -base64 32
FB_CRED_ENC_KEY=

# Hạn mức chống throttle / phát hiện
FB_MAX_CRAWLS_PER_DAY=5
FB_MAX_CHECKPOINTS=3
FB_MAX_POSTS_PER_RUN=6
FB_MAX_SCROLLS=8

# Playwright
FB_HEADLESS=true
FB_PROXY_URL=
FB_VIEWPORT_WIDTH=
FB_VIEWPORT_HEIGHT=
FB_USER_AGENT=

# ---------- Chỉ dùng cho script test thủ công (src/scripts/) ----------
# Tài khoản công cụ: điền giá trị THẬT trong .env, KHÔNG để ở file mẫu này.
FB_TEST_LABEL=
FB_TEST_LOGIN=
FB_TEST_PASSWORD=
FB_ENTRY_URL=
FB_GROUP_ID=
